// Biomes (issue #11): how a circuit is dressed. A circuit file names its biome (`biome:
// "Prairie"`); several circuits can share one, and a biome can mix several packs of models.
// Compiled into the game, like the roster: a test checks every rule below, and that each model
// exists in `assets/models/` with its line in `assets/CREDITS.md`.
//
// - `palette`: sRGB colors (0 to 1) of the sky, the ambient light, the ground and the track
//   (the road, the curbs and the walls' panels go in pairs: they alternate along the track).
//   `ambient_brightness` lights what the sun does not (the walls' side in the shade, issue #47).
// - `scatter`: pieces strewn beyond the walls, at random but always the same for a circuit (its
//   `decor_seed`). `models` are drawn in turn at random, as "pack/name" (the file
//   `assets/models/pack/name.glb`); `count` pieces, `height` in meters (between the two),
//   `radius` their footprint (m: they keep that far from the walls and from each other),
//   `distance` the gap between the walls' outer face and their footprint (m, between the two),
//   `side`: Both, Inside, Outside (of the loop), Left or Right (of the driver). `shadows: false`
//   for the small ones: they cost little without shadows.
// - `rows`: pieces in a row along the walls, every `spacing` meters from `offset`, facing the
//   track (`yaw` in degrees turns them more), `gap` m beyond the walls. `models` in turn.
// - `music` (issue #104): the music of its circuits that name none of their own, a piece of
//   `assets/data/music.ron`.
// - Pieces never stand on the road, the curbs, the shoulders or the walls: where there is no
//   room (a tight hairpin), a piece is moved or left out. No piece higher than 1.6 m stands
//   inside a tight turn (below 40 m of radius): the road out of the turn stays in sight.
// - `far` (issue #146, required): the far decor, so that one never sees the edge of the world
//   nor an empty horizon (src/track/far.rs). Drawn in one mesh, without shadows nor collider. The
//   ground beyond the circuit's goes on (the palette's `ground`) far past the fog. `fog: (start,
//   end)`: meters from the camera where things start to fade into the sky's color, and where they
//   are gone. `layers`, distances in meters beyond the circuit's ground (it reaches 80 m beyond
//   the centerline's bounds):
//   - `Sea(color, from, beach)`: the ground beyond turns into the sea `from` meters out, after a
//     beach of `beach` meters (the palette's `sand`);
//   - `Range(distance, depth, height, spacing, color, top)`: a closed ring of mountains (hills,
//     cliffs) all around, its ridge `distance` out, its foot `depth` wide, a peak every `spacing`
//     meters, `height` high (never below the first: what closes the horizon); `top: (color, at)`
//     colors what is above `at` meters (snow, a lighter band);
//   - `Peaks(count, distance, height, radius, flat, sides, color, top)`: lone peaks (`flat`: their
//     top as wide as that much of their foot, a mesa; 0, a point; `sides`, 6 by default);
//   - `Clouds(count, distance, altitude, size, color)`;
//   - `Pieces(models, count, height, radius, distance, side)`: the biome's models at mid-distance,
//     big, `distance` meters beyond the walls (like `scatter`), never on the sea, no shadows.
//   A circuit may add layers of its own (`far_decor` in its file).
[
    (
        // A meadow with a racing circuit's dressing (Nature Kit and Racing Kit). Issue #108: a
        // circuit twice as long, hills and giant oaks: more pieces, taller ones (the scale).
        name: "Prairie",
        music: "pure-raceway",
        palette: (
            sky: (0.55, 0.80, 0.95),
            ambient: (0.92, 0.96, 1.0),
            ambient_brightness: 700.0,
            ground: (0.42, 0.72, 0.40),
            asphalt: (0.42, 0.43, 0.48),
            curbs: ((0.85, 0.20, 0.20), (0.95, 0.95, 0.95)),
            shoulder: (0.40, 0.70, 0.36),
            sand: (0.90, 0.80, 0.55),
            walls: ((0.95, 0.95, 0.96), (0.91, 0.36, 0.34)),
            wall_top: (0.98, 0.98, 0.98),
            skirt: (0.62, 0.50, 0.40),
        ),
        far: (
            fog: (220.0, 1300.0),
            layers: [
                // Green hills all around, and blue mountains behind them, their tops snowy.
                Range(distance: 170.0, depth: 150.0, height: (34.0, 72.0), spacing: 46.0,
                      color: (0.43, 0.66, 0.37)),
                Range(distance: 430.0, depth: 260.0, height: (110.0, 230.0), spacing: 62.0,
                      color: (0.50, 0.56, 0.66), top: ((0.95, 0.96, 0.99), 185.0)),
                // Round wooded buttes in front of the hills.
                Peaks(count: 16, distance: (40.0, 150.0), height: (22.0, 46.0),
                      radius: (30.0, 55.0), flat: 0.35, sides: 8, color: (0.33, 0.56, 0.31)),
                Clouds(count: 22, distance: (0.0, 520.0), altitude: (110.0, 190.0),
                       size: (50.0, 110.0), color: (1.0, 1.0, 1.0)),
                // A forest of giant oaks and pines at mid-distance, and big rocks.
                Pieces(models: ["nature-kit/tree_oak", "nature-kit/tree_fat",
                                "nature-kit/tree_default", "nature-kit/tree_pineRoundA"],
                       count: 150, height: (16.0, 28.0), radius: 6.0, distance: (55.0, 210.0)),
                Pieces(models: ["nature-kit/rock_largeA", "nature-kit/rock_largeB"],
                       count: 18, height: (6.0, 12.0), radius: 7.0, distance: (60.0, 200.0)),
            ],
        ),
        rows: [
            // Flags along the outside of the loop, red and green in turn.
            (models: ["racing-kit/flagRed", "racing-kit/flagGreen"], spacing: 36.0, offset: 18.0,
             height: 4.5, radius: 1.0, gap: 0.6, side: Outside),
        ],
        scatter: [
            // Giant oaks, far apart: they give the scale and mark the meadow from afar.
            (models: ["nature-kit/tree_oak", "nature-kit/tree_fat"],
             count: 10, height: (14.0, 20.0), radius: 4.5, distance: (6.0, 40.0)),
            // Big round trees, both sides.
            (models: ["nature-kit/tree_oak", "nature-kit/tree_default", "nature-kit/tree_detailed",
                      "nature-kit/tree_fat", "nature-kit/tree_cone"],
             count: 72, height: (7.0, 11.0), radius: 2.4, distance: (2.0, 30.0)),
            // Pines further away, outside.
            (models: ["nature-kit/tree_pineRoundA", "nature-kit/tree_pineDefaultA"],
             count: 28, height: (9.0, 13.0), radius: 2.4, distance: (14.0, 36.0), side: Outside),
            // Rocks.
            (models: ["nature-kit/rock_largeA", "nature-kit/rock_largeB", "nature-kit/rock_tallA"],
             count: 22, height: (1.0, 2.6), radius: 1.8, distance: (1.0, 22.0)),
            // Bushes, stumps, mushrooms and flowers: small, no shadows.
            (models: ["nature-kit/plant_bushLarge", "nature-kit/plant_bush", "nature-kit/plant_bushDetailed"],
             count: 64, height: (0.8, 1.4), radius: 1.0, distance: (0.3, 16.0), shadows: false),
            (models: ["nature-kit/stump_round", "nature-kit/mushroom_redGroup", "nature-kit/mushroom_tanGroup"],
             count: 36, height: (0.5, 0.9), radius: 0.6, distance: (0.3, 14.0), shadows: false),
            (models: ["nature-kit/flower_redA", "nature-kit/flower_yellowA", "nature-kit/flower_purpleA"],
             count: 200, height: (0.5, 0.8), radius: 0.35, distance: (0.2, 12.0), shadows: false),
        ],
    ),
