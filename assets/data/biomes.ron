            (models: ["holiday-kit/candy-cane-red", "holiday-kit/candy-cane-green"], spacing: 14.0,
             height: 3.6, radius: 1.3, gap: 0.3, side: Both),
        ],
        scatter: [
            // Giant cupcakes, muffins and sundaes.
            (models: ["food-kit/cupcake", "food-kit/muffin", "food-kit/sundae"],
             count: 16, height: (3.0, 5.0), radius: 3.2, distance: (2.0, 26.0)),
            // Giant donuts, lying flat.
            (models: ["food-kit/donut-sprinkles", "food-kit/donut-chocolate"],
             count: 10, height: (1.4, 2.2), radius: 3.4, distance: (2.0, 24.0)),
            // Lollipops and popsicles, tall and thin.
            (models: ["food-kit/lollypop", "food-kit/popsicle"],
             count: 20, height: (4.5, 7.5), radius: 1.6, distance: (1.0, 28.0)),
            // Presents and gingerbread men.
            (models: ["holiday-kit/present-a-cube", "holiday-kit/present-b-round", "holiday-kit/gingerbread-man"],
             count: 14, height: (1.4, 2.8), radius: 1.4, distance: (1.0, 20.0)),
            // Strawberries, cherries, cookies and whipped cream: small, no shadows.
            (models: ["food-kit/strawberry", "food-kit/cherries", "food-kit/cookie-chocolate",
                      "food-kit/whipped-cream"],
             count: 70, height: (0.5, 1.1), radius: 0.7, distance: (0.2, 14.0), shadows: false),
        ],
    ),
    (
        // A snowy mountain pass (issue #19): snowy firs, snowmen and reindeer (Holiday Kit), tall
        // dark pines and grey stones (Nature Kit). Snow patches for the off-road.
        name: "Neige",
        palette: (
            sky: (0.70, 0.80, 0.92),
            ambient: (0.90, 0.95, 1.0),
            ambient_brightness: 760.0,
            ground: (0.92, 0.94, 0.98),
            asphalt: (0.36, 0.38, 0.46),
            curbs: ((0.80, 0.16, 0.22), (0.97, 0.97, 0.98)),
            shoulder: (0.84, 0.89, 0.95),
            sand: (0.98, 0.99, 1.0),
            walls: ((0.97, 0.98, 1.0), (0.32, 0.52, 0.84)),
            wall_top: (0.98, 0.99, 1.0),
            skirt: (0.52, 0.50, 0.54),
        ),
        rows: [
            // Lanterns along the outside of the loop.
            (models: ["holiday-kit/lantern"], spacing: 24.0, offset: 12.0,
             height: 2.2, radius: 0.7, gap: 0.5, side: Outside),
        ],
        scatter: [
            // Snowy firs, both sides.
            (models: ["holiday-kit/tree-snow-a", "holiday-kit/tree-snow-b", "holiday-kit/tree-snow-c"],
             count: 54, height: (6.0, 10.0), radius: 2.4, distance: (2.0, 30.0)),
            // A few decorated ones.
            (models: ["holiday-kit/tree-decorated-snow"],
             count: 6, height: (6.0, 8.0), radius: 2.6, distance: (3.0, 24.0)),
            // Tall dark pines further away, outside.
            (models: ["nature-kit/tree_pineTallA", "nature-kit/tree_pineTallB"],
             count: 18, height: (9.0, 13.0), radius: 1.8, distance: (12.0, 36.0), side: Outside),
            // Grey stones.
            (models: ["nature-kit/stone_tallA", "nature-kit/stone_tallB"],
             count: 14, height: (1.2, 2.8), radius: 2.0, distance: (1.0, 22.0)),
            // Snowmen and reindeer.
            (models: ["holiday-kit/snowman", "holiday-kit/snowman-hat"],
             count: 10, height: (2.2, 3.2), radius: 1.6, distance: (1.0, 18.0)),
            (models: ["holiday-kit/reindeer"],
             count: 6, height: (2.0, 2.6), radius: 1.4, distance: (2.0, 20.0)),
            // Snow piles, sleds, benches and presents: small, no shadows.
            (models: ["holiday-kit/snow-pile", "holiday-kit/sled", "holiday-kit/bench",
                      "holiday-kit/present-b-cube"],
             count: 50, height: (0.4, 0.9), radius: 0.9, distance: (0.3, 14.0), shadows: false),
        ],
    ),
    (
        // A pirates' cove (issue #19): palm trees, sandy rocks, barrels, crates, chests and cannons
        // (Pirate Kit), and beach plants (Nature Kit).
        name: "Plage",
        palette: (
            sky: (0.48, 0.82, 0.98),
            ambient: (1.0, 0.97, 0.90),
            ambient_brightness: 720.0,
            ground: (0.93, 0.84, 0.62),
            asphalt: (0.50, 0.48, 0.50),
            curbs: ((0.15, 0.55, 0.85), (0.97, 0.97, 0.97)),
            shoulder: (0.86, 0.78, 0.55),
            sand: (0.97, 0.90, 0.70),
            walls: ((0.97, 0.97, 0.95), (0.16, 0.62, 0.76)),
            wall_top: (0.98, 0.98, 0.97),
            skirt: (0.66, 0.52, 0.36),
        ),
        rows: [
            // Flags along the outside of the loop, the pirates' and plain ones in turn.
            (models: ["pirate-kit/flag-pirate", "pirate-kit/flag"], spacing: 34.0, offset: 17.0,
