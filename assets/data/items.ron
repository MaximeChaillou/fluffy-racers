// Distribution des objets selon la distance au leader (GD § 8, « première proposition, à régler »).
//
// Une ligne par tranche de distance : `from` est la distance au leader (m, le long de la ligne de
// course, tours compris) à partir de laquelle la ligne s'applique, jusqu'à la suivante. La
// première commence à 0 : le leader l'utilise. Les poids sont ceux du game design (en %).
//
// Tous les objets sont en jeu depuis #18. En ligne, le jeu retire lui-même ceux qui ne passent pas
// encore par le réseau (#61) et redistribue leur poids proportionnellement sur les autres objets de
// la même ligne (`src/items/table.rs`) ; il fait de même avec l'oreiller géant quand ses règles
// l'interdisent (un seul à la fois, 30 s entre deux, aucun avant 20 s de course).
//
// Noms : Pelure, PelureX3, Pelote (pelote de laine), PeloteX3, Abeille, AbeilleX3, Piment,
// PimentX3, CroquetteDoree ; phase 2 : PimentDore, Bombe (bombe à confettis), Chantilly,
// SuperCalin, Fusee (fusée à confettis), Degonflage, OreillerGeant, KlaxonCanard.
(
    rows: [
        // Leader, ou à moins de 15 m.
        (from: 0.0, items: [
            (Pelure, 30), (Pelote, 25), (CroquetteDoree, 20), (PelureX3, 10), (KlaxonCanard, 10),
            (Bombe, 5),
        ]),
        // 15 à 50 m.
        (from: 15.0, items: [
            (Pelote, 20), (Abeille, 25), (Pelure, 15), (Piment, 15), (Bombe, 10), (PeloteX3, 10),
            (Chantilly, 5),
        ]),
        // 50 à 120 m.
        (from: 50.0, items: [
            (Abeille, 25), (AbeilleX3, 15), (Piment, 20), (PimentX3, 15), (Chantilly, 10),
            (OreillerGeant, 5), (PeloteX3, 10),
        ]),
        // 120 à 250 m.
        (from: 120.0, items: [
            (PimentX3, 25), (AbeilleX3, 20), (SuperCalin, 15), (PimentDore, 15), (OreillerGeant, 10),
            (Fusee, 10), (Degonflage, 5),
        ]),
        // Plus de 250 m.
        (from: 250.0, items: [
            (SuperCalin, 25), (Fusee, 25), (PimentDore, 20), (PimentX3, 15), (Degonflage, 10),
            (OreillerGeant, 5),
        ]),
    ],
)
