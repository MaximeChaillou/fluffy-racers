// The circuits of this folder, as the admin panel lists them (issue #36): a browser cannot list
// a folder, so every new `*.track.ron` file is added here too (a test checks it). `name` is the
// circuit's `name`, `file` its file in this folder. The first one is the game's circuit. The
// Lagon Duvet (issue #20) shows the special environments: the glider and the water; the Ruban
// Réglisse (issue #78), the anti-gravity; the Corniche Cannelle (issue #107), the reference circuit
// of the guide « Conception des circuits » (the sides without wall, the shortcuts, the risky jump);
// the Échappée Pissenlit (issue #119), the first long race: an open circuit, in sections (one per
// cup, its last race, a final); `long: true` says so to the screens that only read this list.
// Issue #110: the Forêt Frimousse (a forest of giant mushrooms: the hidden road behind a waterfall)
// and the Falaises Flanelle (cliffs at sunset: the glide, the hidden road behind a stack of
// crates), the first two circuits of the third cup. Issue #111: the Coteau Citrouille (a
// hillside of pumpkins at dusk: its lacets, the hidden road behind a stack of crates) and the
// Périple Polochon, the second long race (a kingdom: the wall on its rampart, the glide, the
// ford, the finish under its castle), the final of the third cup, now offered. Issue #168: the
// Bourg Bouillotte (a hill town at the blue hour: the jump on its top, the lacets down through it,
// the hidden road behind the market's crates), the first circuit of the fourth cup,
// the « Coupe Pantoufle » (offered since it has its four circuits). Issue #112: the Manège
// Mousseline (a fair on its hill: the climb along its big coaster, the jump on its top, the
// lacets down through the stalls, the hidden road behind a curtain of tall grass), the second
// circuit of the fourth cup; then the Marais Mitaine (a marsh in the misty morning: the jump and
// the glide over the marsh, the ford, the lacets back up, the hidden road behind a stack of
// crates), the third; then the Odyssée Ouatée, the third long race (a hushed moon: the jump on its
// ridge and the glide into a crater, the wall along its rampart, the climb to a plateau, the
// hidden road behind a stack of crates, the finish at its spaceport), the fourth and its final:
// the Coupe Pantoufle is offered.
//
// Issue #99: the cups of the championship (« Jouer solo »): four circuits each, in the order of
// `circuits` (the first cup races the first four, the second one the next four...), each with
// an original name and its icon (`Trophy`, `Medal`, `Rosette`, `Target`, `Podium`: icons of
// Kenney's Game Icons, `assets/ui/icons/`). A cup that does not have its four circuits yet is not
// offered (its circuits can be raced alone, or in a custom championship).
(
    circuits: [
        (name: "Prairie Pompon", file: "prairie.track.ron"),
        (name: "Anneau Guimauve", file: "anneau.track.ron"),
        (name: "Crique Câline", file: "crique.track.ron"),
        (name: "Col des Moufles", file: "col.track.ron"),
        (name: "Lagon Duvet", file: "lagon.track.ron"),
        (name: "Ruban Réglisse", file: "ruban.track.ron"),
        (name: "Corniche Cannelle", file: "corniche.track.ron"),
        (name: "Échappée Pissenlit", file: "echappee.track.ron", long: true),
        (name: "Forêt Frimousse", file: "foret.track.ron"),
        (name: "Falaises Flanelle", file: "falaises.track.ron"),
        (name: "Coteau Citrouille", file: "coteau.track.ron"),
        (name: "Périple Polochon", file: "periple.track.ron", long: true),
        (name: "Bourg Bouillotte", file: "bourg.track.ron"),
        (name: "Manège Mousseline", file: "manege.track.ron"),
        (name: "Marais Mitaine", file: "marais.track.ron"),
        (name: "Odyssée Ouatée", file: "odyssee.track.ron", long: true),
    ],
    cups: [
        (name: "Coupe Doudou", icon: Trophy),
        (name: "Coupe Nuage", icon: Medal),
        (name: "Coupe Câlin", icon: Rosette),
        (name: "Coupe Pantoufle", icon: Target),
    ],
)
