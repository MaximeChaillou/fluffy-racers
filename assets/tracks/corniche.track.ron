        (from: 150.921, to: 163.828, kind: Grass, width: 5.0,
         cover: Some((kind: Panel, at: 26.0)),
         points: [(59.96, 16.00, 94.63), (53.49, 16.00, 93.78), (47.46, 16.00, 91.28), (42.48, 16.00, 88.41), (37.50, 16.00, 85.53), (32.52, 16.00, 82.66), (27.54, 16.00, 79.78), (22.54, 16.00, 76.28), (18.23, 16.00, 71.97), (14.73, 16.00, 66.97), (12.15, 16.00, 61.44), (10.57, 16.00, 55.55), (10.04, 16.00, 49.47)]),
