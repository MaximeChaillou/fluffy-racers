    // step: `track::mesh`'s test finds each of its corners within a meter of a sample of the road
    // only where the road is straight).
    drops: [
        (at: 122.5, height: 2.5),
    ],
    offroad: [
        // Sand at the inside of the first hairpin: cutting the apex costs speed. Issue #193: from
