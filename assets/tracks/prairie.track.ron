    // Issue #107: the sides without wall: the inside of the jump's corner (a drop of 6.5 m), where
    // the hidden road leaves the road and comes back to it (only where its own road lies beyond:
    // 6.5 m above the meadow), the inside of the tight turn at the bottom (the grass path).
    // Everywhere else, walls: around the hairpins, where the pack bunches up (their shoulders
    // wide, 5 m: their islands small, the road out of them in sight), at the end of
    // the start straight, on the climb and the descent (less than 5 m above the meadow: a kart
    // over the edge would drive on below the road, not seen fallen). A kart that leaves the road
    // where it has no wall is out of the track: the pelican comes for it.
    open_edges: [
        (from: 74.609, to: 82.913, side: Right),
        (from: 85.657, to: 87.404, side: Right),
        (from: 99.762, to: 101.509, side: Right),
        (from: 142.390, to: 154.626, side: Right),
    ],
    shortcuts: [
        // The risky jump: lined up on the road, onto a ramp aimed across the drop inside the
        // corner (a 6.5 m fall), landing on the road after it (on the landing, 16 m after its
        // start: the side without wall ends where the flight comes over the road). Fast enough,
        // it saves the corner; too slow, it falls.
        (from: 74.859, to: 82.788, kind: Jump, width: 8.0, ramp_width: 6.0,
         ramp_length: 8.0, ramp_angle: 12.0,
         points: [(142.66, 6.50, -84.19), (154.60, 6.50, -81.41), (159.69, 6.50, -75.25), (182.83, 6.50, -47.27)]),
