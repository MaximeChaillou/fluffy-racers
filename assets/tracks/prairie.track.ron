        (from: 87.657, to: 89.404, side: Right),
        (from: 101.762, to: 103.509, side: Right),
        (from: 143.447, to: 155.626, side: Right),
    ],
    shortcuts: [
        // Issue #193: its ramp is grass: without a boost, a kart slows down on it and falls short.
