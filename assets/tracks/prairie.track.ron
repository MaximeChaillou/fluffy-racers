    // Issue #180 (GD § 16, rule 3): bumps, a real rise and fall of the road, 2.2 m high (a kart
    // and its tallest driver): a fast kart takes off from their crest (a trick there gives the
    // boost), a slow one rolls over. Where nothing turns for long after: up the Butte (the pad at
    // its foot launches the karts onto it), and out of the last corner toward the line, before
    // the grid. Not on the short straights between two hairpins: a kart that lands there is too
    // late to set up its drift (the bots, and a player on the keyboard, lose their orange).
    bumps: [
        (at: 44.2, height: 2.2, length: 32.0),
        (at: 162.2, height: 2.2, length: 28.0),
    ],
    // Issue #180: a drop of 2.5 m off the terrace of the meadow's hairpin, on the straight north:
    // the road stops at its edge and goes on below, in its line (a trick off the edge gives the
    // boost). Not a fall: no pelican. (Down the Butte, the drop landed too close to the hairpin
    // below it.)
    drops: [
        (at: 123.5, height: 2.5),
    ],
    offroad: [
        // Sand at the inside of the first hairpin: cutting the apex costs speed. Issue #193: from
        // 0.7 (0.55 before): with the wider hairpin, a drift held on the road passes beside it
        // (`race::scenario_tests::a_keyboard_player_gets_an_orange_in_every_big_turn`).
        (from: 19.370, to: 23.141, left: 0.7, right: 1.0),
    ],
    // Issue #107: the sides without wall: the inside of the jump's corner (a drop of 6.5 m), where
    // the hidden road leaves the road and comes back to it (only where its own road lies beyond:
    // 6.5 m above the meadow), the inside of the tight turn at the bottom (the grass path).
    // Everywhere else, walls: around the hairpins, where the pack bunches up (their shoulders
    // wide, 5 m: their islands small, the road out of them in sight), at the end of
    // the start straight, on the climb and the descent (less than 5 m above the meadow: a kart
    // over the edge would drive on below the road, not seen fallen). A kart that leaves the road
    // where it has no wall is out of the track: the pelican comes for it.
    open_edges: [
        (from: 74.609, to: 82.913, side: Right),
        (from: 85.657, to: 87.404, side: Right),
        (from: 99.762, to: 101.509, side: Right),
        (from: 142.390, to: 154.626, side: Right),
