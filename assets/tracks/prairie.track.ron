         points: [(179.90, 6.50, -30.21), (178.94, 6.50, -15.76), (178.37, 6.50, -1.30), (178.18, 6.50, 13.17), (178.38, 6.50, 27.65), (178.96, 6.50, 42.13), (179.94, 6.50, 56.62)]),
