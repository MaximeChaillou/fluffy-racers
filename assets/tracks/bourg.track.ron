        // where the drop separates it from the road: it breaks with a boost, a kart without one
        // bounces off.
        (from: 176.921, to: 189.828, kind: Grass, width: 5.0,
         points: [(59.96, 10.00, 135.36), (53.49, 10.00, 134.51), (47.46, 10.00, 132.01), (42.48, 10.00, 129.14), (37.50, 10.00, 126.26), (32.52, 10.00, 123.39), (27.54, 10.00, 120.51), (22.54, 10.00, 117.01), (18.23, 10.00, 112.70), (14.73, 10.00, 107.70), (12.15, 10.00, 102.17), (10.57, 10.00, 96.28), (10.04, 10.00, 90.20)],
         cover: Some((kind: Panel, at: 26.0))),
    ],
    // Issue #144 (GD « Conception des circuits », rule 8): on one side of the road each, the side
