    // a gentle S), and on the way back to the line, past where the grass bridge comes back.
    // Issue #168: the first one long (36 m, the Échappée Pissenlit's lesson, GD § 16 #150): lower,
    // the same trick. 22 m long (the Coteau Citrouille's), it threw Hard bots still in the pack
    // out of the hairpin, and some went over the bulge's walls (once in free driving on the CI);
    // elsewhere (later on the approach, down the bakers' street, on the belfry's terrace) it was
    // worse: the karts landed too close to the next turn or to the drop.
    bumps: [
        (at: 147.5, height: 2.2, length: 36.0),
        (at: 190.5, height: 2.2, length: 22.0),
    ],
    // Issue #184: a drop of 4 m off the belfry's terrace, 34 m after the hairpin before it: 35 m
    // straight below it, 86 m on to the next hairpin (more than 2 s: the bots trick off it).
    drops: [
        (at: 89.5, height: 4.0),
    ],
    shortcuts: [
        // Issue #193: its ramp is grass: without a boost, a kart slows down on it and falls short.
        // The risky jump: lined up on the road, onto a ramp aimed across the drop inside the tight
        // corner, landing on the road after it. Fast enough, it saves the corner; too slow, it
        // falls.
        (from: 56.450, to: 66.457, kind: Jump, width: 8.0, ramp_width: 6.0,
         ramp_length: 8.0, ramp_angle: 12.0,
         points: [(174.69, 33.00, -124.51), (189.70, 33.00, -122.52), (194.64, 33.00, -115.00), (211.70, 32.58, -89.01), (211.70, 32.58, -80.01)]),
        // Issue #193: grass, like every shortcut: it pays only with a boost.
        // The hidden road: narrow (5 m), straight behind the giant belfry while the road goes round
