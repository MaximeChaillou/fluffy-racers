// "Périple Polochon": the second long race (issue #111, GD § 1 « Les courses longues »), the final
// of the third cup, an open circuit: one long way of about 5.7 km through a kingdom of meadows,
// ramparts and a castle, from its start line to a finish elsewhere, in three sections (no lap).
// Original layout. A journey: up the town's lacets, the wall (anti-gravity) along the rampart
// (section 1); the lacets down the east, the risky jump's corner on the cliff, the glide down to
// the river, the ford, back west (section 2); the bulge whose hidden road runs behind a
// waterfall, the grass bridge behind a panel, the lacets down to the castle and the finish under
// its towers (section 3). It follows the guide « Conception des circuits »: many hairpins and
// tight corners in each section (a section is as dense as a lap), walls but where a drop is worth
// the risk, the hidden shortcuts of issue #156 (their pieces, the risky jump's and the glide's
// too, are the Corniche Cannelle's, as laid in the Forêt Frimousse and the Falaises Flanelle:
// their gains and their hiding were tuned; the wall is the Ruban Réglisse's first zone).
// Issue #221: its heights, from -2 to 46 m (the rampart), on a hillside that carries its lacets;
// the drawing seen from above is the same.
//
// Drawn as a plan of straights and arcs, its points every 8 m along it.
//
// Format: see src/track/data.rs (`open`: the finish, the road's ends, the sections). Point 0 is
// the start line; karts drive toward point 1 (north, -Z).
(
    name: "Périple Polochon",
    // Dressing (issue #11): the kingdom (`assets/data/biomes.ron`), the same every time (seed), and
    // pieces placed by hand: checkered flags at the start line and at the finish, a watchtower by
    // the jump's corner, a giant pine that hides the hidden road, the castle's towers by the finish.
    biome: "Royaume",
    // Issue #104: its music (`assets/data/music.ron`).
    music: "trance-adventure",
    decor_seed: 112,
    // Issue #221: the kingdom's terrain (`assets/data/biomes.ron`), its hills 50 m high (36 m),
    // and it hugs the road (`embank`, rise over run: about 31°, as on the circuits of #211): the
    // town's lacets climb to the rampart, 46 m up (10 m before), and the castle's come down from
    // the bulge, 36 m up, carried by the hillside up to their walls instead of skirts down to the
    // meadow. The voids stay (the jump's corner, the glide's drop: 6 m under the road at least);
    // the river and the wall on the rampart keep their ground.
    terrain: (height: 50.0, scale: 160.0, ridges: 0.15, floor: 0.25, rock: (0.66, 0.60, 0.54),
              embank: 0.6),
    checkpoint_spacing: 25.0,
    // Issue #146: more far decor than the kingdom's: a long race crosses a wide country, the
    // corners of its ground far from the road; a ring of low wooded hills right beyond its ground,
    // in front of the kingdom's hills and mountains, and giant pines and towers deep in the
    // meadows between its loops (« pas de bord du monde »: the farthest corner of its ground).
    // Issue #221: the hills higher (34 to 54 m before): from the rampart, 46 m up, one saw over
    // them.
    far_decor: [
        Range(distance: 60.0, depth: 60.0, height: (60.0, 80.0), spacing: 40.0,
              color: (0.36, 0.58, 0.34)),
        Pieces(models: ["castle-kit/tree-large", "nature-kit/tree_pineTallA_detailed",
                        "castle-kit/tower-square-roof"],
               count: 40, height: (22.0, 30.0), radius: 9.0, distance: (100.0, 380.0)),
    ],
    props: [
        (model: "racing-kit/flagCheckers", at: 0.0, side: Both, height: 4.0, radius: 0.9, gap: 1.8),
        (model: "racing-kit/flagCheckers", at: 682.000, side: Both, height: 4.0, radius: 0.9, gap: 1.8),
        (model: "castle-kit/tower-square-roof", at: 411.204, side: Left, height: 24.0, radius: 6.0, gap: 2.0),
        (model: "castle-kit/tree-large", at: 533.216, side: Right, height: 24.0, radius: 3.8, gap: 8.0),
        (model: "castle-kit/tower-square-roof", at: 687.000, side: Right, height: 30.0, radius: 8.0, gap: 3.0),
        (model: "castle-kit/tower-square", at: 691.000, side: Right, height: 16.0, radius: 9.0, gap: 4.0),
        (model: "castle-kit/tower-square-roof", at: 695.000, side: Right, height: 26.0, radius: 7.0, gap: 3.0),
        (model: "castle-kit/tower-slant-roof", at: 698.500, side: Right, height: 14.0, radius: 5.0, gap: 3.0),
    ],
