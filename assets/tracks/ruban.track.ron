    // Issue #107: the sides without wall: the inside of the jump's corner, along the bulge (the
    // hidden road) and inside the last corner (the grass bridge), each over a drop of 6 m and
    // more. Everywhere else, walls.
    open_edges: [
        (from: 30.826, to: 41.457, side: Right),
        (from: 126.000, to: 144.351, side: Right),
        (from: 144.173, to: 157.900, side: Right),
    ],
    // Issue #78: the wall, from flat to flat; issue #94: the ceiling, from flat to flat; issue
    // #96: the banked turn, from flat to flat (the third zone, after the other two in this list:
    // their tests know them by their place in it). Issue #151: the old Ruban's, as they were.
    anti_gravity: [
        (from: 57.000, to: 67.000),
        (from: 84.000, to: 99.000),
        (from: 70.000, to: 78.000),
    ],
    // Issue #180 (GD § 16, rule 3): bumps, 2.2 m high (a kart and its tallest driver), where
    // nothing turns for 60 m and more after them: on the way onto the wall, past the drop's foot
    // (the wall's zone is straight, 62 m from the bump's end: 40 m from the bump's end, karts that
    // landed off their line went over the walls where the ribbon narrows into the zone); on the
    // way back to the line, past where the grass bridge comes back, and 40 m behind the line at
    // least (the grid). None out of the S (the bots let go of their drift before taking off: a
    // bump 3 m out of it cost a quarter of an orange mini-turbo a lap).
    bumps: [
        (at: 47.200, height: 2.2, length: 36.0),
        (at: 157.900, height: 2.2, length: 24.5),
    ],
