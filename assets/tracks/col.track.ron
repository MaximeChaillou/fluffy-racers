    // drift for a hairpin. A stone swinging over the left side of the start straight, from a
    // gallows beyond its wall (the karts keep right for the switchback to the left); a log
    // rolling across the left side of the second climb (the same); a rock at the left edge of
    // the jump's wide landing (the summit turns left after it: the karts keep right).
    obstacles: [
        (kind: SwingingStone, at: 7.0, offset: -0.5, sweep: 0.35, period: 3.6),
        (kind: RollingLog, at: 42.0, offset: -0.5, sweep: 0.32, period: 5.0),
        (kind: Rock, at: 66.162, offset: -0.95, size: 1.1, yaw: 20.0),
    ],
    // The bison of the mountain, pacing across the right side of the first climb before the
    // switchback to the right (the karts keep left, on its outside).
    npcs: [
        (kind: Bison, at: 24.0, offset: 0.55, sweep: 0.3, period: 6.5),
    ],
    // Things to drive through: balloons just after the start line (the pack bursts them at GO),
    // crates on the way down, a hay bale at the foot.
    breakables: [
        (kind: Balloon, at: 1.5, offsets: [-0.55, 0.0, 0.55]),
        (kind: Crate, at: 97.5, offsets: [0.6, 0.25]),
        (kind: HayBale, at: 116.5, offsets: [0.5]),
    ],
    // Trick ramp (issue #13): between the two switchbacks at the foot, walled on both sides, far
    // from both.
    trick_ramps: [
        (at: 112.5, offset: 0.0, width: 7.0, length: 7.0, angle: 12.0),
    ],
    // Boost pads (issue #13): about 1 s of boost, on the start straight (over before the first
    // switchback). None just before a hairpin (a bot drifts it from its normal speed) nor before
    // the snow path: it pays only with a boost of one's own (the last switchback's mini-turbo, a
    // piment). None on the pass either: with one there, the bots' fastest laps came within a
    // hair of the « not faster than boosted all along » check (33 m/s on average over a lap).
    boost_pads: [
        (at: 2.5, offset: 0.45),
    ],
    item_boxes: [
        (at: 4.6, offsets: [-0.6, -0.2, 0.2, 0.6]),
        (at: 39.5, offsets: [-0.5, 0.0, 0.5]),
        (at: 110.0, offsets: [-0.5, 0.0, 0.5]),
        (at: 57.984, offsets: [-0.7], double: true),
    ],
    // Croquettes (issue #14): lines along the straights, off the middle of the road (go and get
    // them), never on the grid. Each one is +1 % of top speed (10 at most) and a mini-boost; they
    // come back 10 s after being picked up.
    croquettes: [
        (from: 2.8, count: 5, spacing: 3.0, offset: -0.42),
        (from: 20.5, count: 4, spacing: 3.0, offset: -0.4),
        (from: 42.5, count: 4, spacing: 3.0, offset: 0.4),
        (from: 74.5, count: 4, spacing: 3.0, offset: 0.4),
        (from: 114.0, count: 4, spacing: 3.0, offset: -0.45),
        (from: 143.3, count: 4, spacing: 3.0, offset: 0.45),
