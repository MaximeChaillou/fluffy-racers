// "Odyssée Ouatée": the third long race (issue #112, GD § 1 « Les courses longues »), the 16th
// circuit, the final of the fourth cup (the Coupe Pantoufle): one long way of about 5.5 km across
// a hushed moon, from its start line to a finish elsewhere, in three sections (no lap). Original
// layout. A journey: the runway of the moon base, the S of its hangars, the lacets up a ridge,
// the risky jump's corner on its top and the glide down into a crater (section 1); the lacets
// across the crater's floor (a drop of 4 m), the wall along its rampart (anti-gravity), back
// down its outer slope (section 2); the level climb to a plateau in anti-gravity, the bulge whose
// hidden road runs behind a stack of crates, the grass bridge behind a panel, the lacets down to
// the spaceport and the finish (section 3). It follows the guide « Conception des circuits »:
// many hairpins in each section (a section is as dense as a lap), walls but where a drop is
// worth the risk, the hidden shortcuts of issue #156. The pieces of the jump and the glide, of
// the wall, and of the climb, the bulge and the grass bridge are the Périple Polochon's (tuned:
// their gains, their hiding), with another pair of covers; the rest is new (the S of two hairpins
// back to back, the four sets of lacets, the drop, the finish). No water.
//
// Drawn as a plan of straights and arcs (hairpins of 22 m, tight corners of 18 m), its points
// every 8 m along it (the parameters below follow them). The generator is not in the repository.
//
// Format: see src/track/data.rs (`open`: the finish, the road's ends, the sections). Point 0 is
// the start line; karts drive toward point 1 (north, -Z).
(
    name: "Odyssée Ouatée",
    // Dressing (issue #11): the moon (`assets/data/biomes.ron`, Kenney's Space Kit and the Nature
    // Kit's grey stones), the same every time (seed), and pieces placed by hand: checkered flags
    // at the start line and at the finish, a giant satellite dish by the jump's corner, a giant
    // crystal that hides the hidden road, the spaceport's hangars by the finish.
    biome: "Lune",
    // Issue #104: its music (`assets/data/music.ron`).
    music: "space-adventure",
    decor_seed: 116,
    // Issue #195: the moon's terrain (`assets/data/biomes.ron`), hugging the road (`embank`, as
    // on the circuits of #211): the ridge of the base, the crater's rim and the plateau carried
    // by their slopes. The voids stay (the jump's corner, the glide's drop).
    terrain: (height: 46.0, scale: 160.0, ridges: 0.2, floor: 0.25, rock: (0.52, 0.52, 0.56),
              embank: 0.6),
    checkpoint_spacing: 25.0,
    // Issue #146: more far decor than the moon's: a long race crosses a wide country, the corners
    // of its ground far from the road; a ring of low grey rims right beyond its ground, and giant
    // dishes, crystals and hangars deep in the plains between its loops.
    far_decor: [
        Range(distance: 30.0, depth: 40.0, height: (60.0, 80.0), spacing: 40.0,
              color: (0.50, 0.50, 0.56)),
        Pieces(models: ["space-kit/satelliteDish_large", "space-kit/rock_crystalsLargeA",
                        "space-kit/hangar_roundGlass"],
               count: 40, height: (22.0, 30.0), radius: 9.0, distance: (100.0, 380.0)),
    ],
    props: [
        (model: "racing-kit/flagCheckers", at: 0.0, side: Both, height: 4.0, radius: 0.9, gap: 1.8),
        (model: "racing-kit/flagCheckers", at: 692.267, side: Both, height: 4.0, radius: 0.9, gap: 1.8),
        // Hangars along the runway.
        (model: "space-kit/hangar_largeA", at: 3.0, side: Right, height: 9.0, radius: 7.0, gap: 3.0),
        (model: "space-kit/hangar_roundA", at: 9.0, side: Left, height: 8.0, radius: 6.0, gap: 3.0),
        // A giant satellite dish by the jump's corner, over the crater.
        (model: "space-kit/satelliteDish_large", at: 189.204, side: Left, height: 22.0, radius: 6.0, gap: 2.0),
        // A giant crystal in the bulge: the hidden road runs behind it.
        (model: "space-kit/rock_crystalsLargeA", at: 541.216, side: Right, height: 24.0, radius: 3.8, gap: 8.0),
        // The spaceport by the finish.
        (model: "space-kit/hangar_largeB", at: 697.267, side: Right, height: 14.0, radius: 9.0, gap: 3.0),
        (model: "space-kit/hangar_roundGlass", at: 701.267, side: Left, height: 12.0, radius: 8.0, gap: 3.0),
        (model: "space-kit/satelliteDish_detailed", at: 705.267, side: Right, height: 10.0, radius: 5.0, gap: 3.0),
