    // Issue #180 (GD § 16, rule 3): bumps, a real rise and fall of the road, 2.2 m high (a kart and
    // its driver), 30 m long: on the approach of the bulge (its trick lands well before the bulge,
    // whose first turn is gentle) and out of the last corner, before the grid (as on Prairie
    // Pompon). Not on the straights between two hairpins (one lands too late to prepare the drift),
    // nor before a tight corner (a Hard bot boosted off a bump went over the walls of the corner
    // after it).
    bumps: [
        (at: 138.468, height: 2.2, length: 30.0),
        (at: 185.228, height: 2.2, length: 30.0),
    ],
    // Issue #180: a drop of 4 m off the jump's landing, on the way down the cake: the road stops at
    // its edge and goes on below, in its line (a trick off the edge gives the boost: the hairpin
    // after it is 68 m away, the bots trick). Not a fall: no pelican.
    drops: [
        (at: 81.500, height: 4.0),
    ],
    // Issue #107: the sides without wall: the inside of the jump's corner (a drop of 17 m), along
    // the bulge (the hidden road) and inside the last corner (the grass bridge), over a drop of 10
    // m: where a path passes only (the lessons of Prairie Pompon). Everywhere else, walls.
